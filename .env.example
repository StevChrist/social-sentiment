# ── Social Sentiment API — Environment Configuration ─────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is already in .gitignore.

# ── 1. YouTube Data API ───────────────────────────────────────────────────────
# Get your API key from Google Cloud Console (YouTube Data API v3)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# ── 2. Sentiment Engine (Google Gemini 3.5 Flash-Lite) ────────────────────────
# Get your free API key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BATCH_SIZE=100
GEMINI_MAX_CHARS_PER_BATCH=50000
GEMINI_MAX_RETRIES=5
GEMINI_REQUEST_TIMEOUT=60.0

# ── 3. Database (PostgreSQL) ──────────────────────────────────────────────────
# Default Docker compose maps port 5433 -> 5432
DATABASE_URL=postgresql+psycopg2://social:secret@localhost:5433/social_sentiment

# ── 4. Free Tier Quota Protection ─────────────────────────────────────────────
MONTHLY_QUOTA_LIMIT=3000
DAILY_QUOTA_LIMIT=150
MAX_COMMENTS_LIMIT=10000
DEFAULT_MAX_COMMENTS=1000

# ── 5. Application Settings ───────────────────────────────────────────────────
ENV=production
APP_NAME=Social Sentiment API
SENTIMENT_PROVIDER=gemini
